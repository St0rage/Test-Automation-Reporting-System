<!-- Delete Project Alert -->
<% if (projects.length != 0) { %>
    <script>
        
        const projectLength = parseInt("<%= projects.length %>")
    
        var resetAlert = (function () {
            var initAlert = function () {
              
    
              for (let index = 0; index < projectLength; index++) {
                $(`#delete-project-${index}`).click(function (e) {
                  swal({
                    title: "Warning",
                    text: "Tindakan ini dapat menghapus seluruh report didalamnya, anda yakin?",
                    icon: "warning",
                    buttons: {
                      confirm: {
                        text: "Ya",
                        className: "btn btn-success",
                      },
                      cancel: {
                        visible: true,
                        className: "btn btn-danger",
                      },
                    }
                  }).then((del) => {
                    if (del) {
                      $(`#delete-project-${index}`).parent().submit()
                    } else {
                      swal.close();
                    }
                  });
                });
              }
            };
      
            return {
              //== Init
              init: function () {
                initAlert();
              },
            };
          })();
    
          jQuery(document).ready(function () {
            resetAlert.init();
          });
    </script>
    <% } %>

<% if (projectAlert.length > 0) { %>
<script>

    const message = "<%= projectAlert[0] %>"

    var SweetAlert2Demo = (function () {
        var initAlert = function () {

            swal({
                title: "Success",
                text: message,
                icon: "success",
                buttons: {
                    confirm: {
                        visible: true,
                        className: "btn btn-success"
                    }
                }
            }).then((ok) => {
                if (ok) {
                    swal.close()
                }
            })
        };
  
        return {
          //== Init
          init: function () {
            initAlert();
          },
        };
    })();

    //== Class Initialization
    jQuery(document).ready(function () {
        SweetAlert2Demo.init();
      });
</script>    
<% } %>


</body>
</html>
