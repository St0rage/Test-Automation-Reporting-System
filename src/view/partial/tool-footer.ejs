<!-- Delete Tool Alert -->
<% if (tools.length != 0) { %>
    <script>
        
        const toolLength = parseInt("<%= tools.length %>")
    
        var resetAlert = (function () {
            var initAlert = function () {
              
    
              for (let index = 0; index < toolLength; index++) {
                $(`#delete-tool-${index}`).click(function (e) {
                  swal({
                    title: "Warning",
                    text: "Anda yakin ingin menghapus tool ini?",
                    icon: "warning",
                    buttons: {
                      confirm: {
                        text: "Ya",
                        className: "btn btn-success",
                      },
                      cancel: {
                        visible: true,
                        className: "btn btn-danger",
                      },
                    }
                  }).then((del) => {
                    if (del) {
                      $(`#delete-tool-${index}`).parent().submit()
                    } else {
                      swal.close();
                    }
                  });
                });
              }
            };
      
            return {
              //== Init
              init: function () {
                initAlert();
              },
            };
          })();
    
          jQuery(document).ready(function () {
            resetAlert.init();
          });
    </script>
    <% } %>

<!-- Alert Tool -->
<% if (toolAlert.length > 0) { %>
    <script>
    
        const message = "<%= toolAlert[0] %>"
    
        var SweetAlert2Demo = (function () {
            var initAlert = function () {
    
                swal({
                    title: message.toLowerCase().includes("gagal") ? "Failed" : "Success" ,
                    text: message,
                    icon: message.toLowerCase().includes("gagal") ? "error" : "success",
                    buttons: {
                        confirm: {
                            visible: true,
                            className: "btn btn-success"
                        }
                    }
                }).then((ok) => {
                    if (ok) {
                        swal.close()
                    }
                })
            };
      
            return {
              //== Init
              init: function () {
                initAlert();
              },
            };
        })();
    
        //== Class Initialization
        jQuery(document).ready(function () {
            SweetAlert2Demo.init();
          });
    </script>    
<% } %>


</body>
</html>
