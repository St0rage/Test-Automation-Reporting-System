<%- include('../partial/header') %>

<div class="wrapper">
    <!-- Sidebar -->
    <div class="sidebar" data-background-color="dark2">
      <div class="sidebar-logo">
        <!-- Logo Header -->
        <div
          class="logo-header d-flex justify-content-center"
          data-background-color="dark2"
        >
          <a href="/" class="logo">
            <img
              src="/public/img/logo_side.svg"
              alt="navbar brand"
              class="navbar-brand"
              height="50"
            />
          </a>
        </div>
        <!-- End Logo Header -->
      </div>
      <div class="sidebar-wrapper scrollbar scrollbar-inner">
        <div class="sidebar-content">
          <ul class="nav nav-secondary">
            <li class="nav-item <%= activeMenu === 'Dashboard' ? 'active' : '' %>">
              <a href="/">
                <i class="fas fa-home"></i>
                <p>Dashboard</p>
              </a>
            </li>
            <li class="nav-section">
              <span class="sidebar-mini-icon">
                <i class="fa fa-ellipsis-h"></i>
              </span>
              <h4 class="text-section">Menu</h4>
            </li>
            <li class="nav-item <%= activeMenu === 'Users' ? 'active' : '' %>">
              <a href="/users">
                <i class="fas fa-users"></i>
                <p>Users</p>
              </a>
            </li>
            <li class="nav-item <%= activeMenu === 'Teams' ? 'active' : '' %>">
              <a href="/teams">
                <i class="fas fa-sitemap"></i>
                <p>Teams</p>
              </a>
            </li>
            <li class="nav-item <%= activeMenu === 'Projects' ? 'active' : '' %>">
              <a href="/projects">
                <i class="fas fa-flask"></i>
                <p>Projects</p>
              </a>
            </li>
            <li class="nav-item <%= activeMenu === 'Tools' ? 'active' : '' %>">
              <a href="/tools">
                <i class="fas fa-wrench"></i>
                <p>Tools</p>
              </a>
            </li>
            <li class="nav-item <%= activeMenu === 'Others' ? 'active' : '' %>">
              <a href="/others">
                <i class="fas fa-cogs"></i>
                <p>Others</p>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <!-- End Sidebar -->

    <div class="main-panel">
      <div class="main-header">
        <!-- Navbar Header -->
        <nav
          class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom"
        >
          <div class="container-fluid">
            <nav
              class="navbar navbar-header-left navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex"
            >
              <h3 class="fw-bold">Test Automation Reporting System</h3>
            </nav>

            <ul class="navbar-nav topbar-nav ms-md-auto align-items-center">
              <li class="nav-item topbar-user dropdown hidden-caret">
                <a
                  class="dropdown-toggle profile-pic"
                  data-bs-toggle="dropdown"
                  href="#"
                  aria-expanded="false"
                >
                  <div class="avatar-sm">
                    <img
                      src="/public/img/profile2.jpg"
                      alt="..."
                      class="avatar-img rounded-circle"
                    />
                  </div>
                  <span class="profile-username">
                    <span class="op-7">Hi,</span>
                    <span class="fw-bold">Dani</span>
                  </span>
                </a>
                <ul class="dropdown-menu dropdown-user animated fadeIn">
                  <div class="dropdown-user-scroll scrollbar-outer">
                    <li>
                      <div class="user-box d-flex align-items-center">
                        <div class="avatar-lg">
                          <img
                            src="/public/img/profile2.jpg"
                            alt="image profile"
                            class="avatar-img rounded"
                          />
                        </div>
                        <div class="u-text">
                          <h4>Dani Yudistira Maulana</h4>
                          <p class="text-muted">adidata.dani</p>
                        </div>
                      </div>
                    </li>
                    <li>
                      <div class="dropdown-divider"></div>
                      <a class="dropdown-item" href="#">Account Setting</a>
                      <div class="dropdown-divider"></div>
                      <a class="dropdown-item" href="#">Logout</a>
                    </li>
                  </div>
                </ul>
              </li>
            </ul>
          </div>
        </nav>

        
        <!-- End Navbar -->
      </div>

      <div class="container">
        <div class="page-inner">