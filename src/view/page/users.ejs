<%- include('../partial/admin-sidebar') %>

<div class="page-header">
    <h3 class="fw-bold mb-3">Users</h3>
</div>

<div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <div
            class="d-flex justify-content-between align-items-center"
          >
            <div class="card-title">User List</div>
            <div class="d-flex align-items-center">
                <form id="filter-form" action="/users" method="get">
                    <input type="hidden" name="page" value="1">
                    <div class="d-flex align-items-center">
                      <div class="d-flex align-items-center">
                        <div class="px-2 text-center">
                          <span>Search</span>
                        </div>
                        <div>
                          <input
                            type="text"
                            class="form-control form-control-sm"
                            id="date-filter"
                            placeholder="username or name"
                            name="search"
                            value=""
                          />
                        </div>
                      </div>
                      <button
                        type="submit"
                        class="btn btn-sm btn-primary ms-3"
                      >
                        Search
                      </button>
                    </div>
                </form>
                <div class="mx-3 border border-start border-dark-subtle border-1" style="height: 30px;"></div>
                <a href="/users/add-user" class="btn btn-primary btn-sm">Add User</a>
            </div>
          </div>
        </div>
          <div class="card-body">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Username</th>
                  <th scope="col">Name</th>
                  <th scope="col">Team</th>
                  <th scope="col">Role</th>
                  <th scope="col">Reset Password</th>
                  <th scope="col">Action</th>
                </tr>
              </thead>
              <tbody>
                  <% users.forEach((user, index) => { %>   
                    <tr>
                      <td><%= (page - 1) * 10 + index + 1  %></td>
                      <td><%= user.username %></td>
                      <td><%= user.name %></td>
                      <td><%= user.userTeams.length > 0 ? user.userTeams[0].team.name : '-' %></td>
                      <td><%= user.roles.name %></td>
                      <td><%= user.reset ? user.tempPassword : '-' %></td>
                      <td class="d-flex justify-content-center">
                        <a href="/users/edit-user/<%= user.username %>" class="btn btn-primary btn-sm">
                          <div class="d-flex justify-content-center">
                            <i class="fas fa-wrench"></i>
                          </div>
                        </a>
                        <form action="/users/reset-password?_method=PATCH" method="post">
                          <% if (searchQuery) { %>
                            <input type="hidden" name="searchQuery" value="<%= searchQuery %>">
                          <% } %>
                          <input type="hidden" name="id" value="<%= user.id %>">
                          <input type="hidden" name="page" value="<%= page %>">
                          <button type="button" id="reset-user-password-<%= index %>" class="btn btn-success btn-sm">
                            <div class="d-flex justify-content-center">
                              <i class="fas fa-undo"></i>
                            </div>
                          </button>
                        </form>
                        <form action="/users/delete?_method=DELETE" method="post">
                          <% if (searchQuery) { %>
                            <input type="hidden" name="searchQuery" value="<%= searchQuery %>">
                          <% } %>
                          <input type="hidden" name="id" value="<%= user.id %>">
                          <input type="hidden" name="page" value="<%= page %>">
                          <button type="button" id="delete-user-<%= index %>" class="btn btn-danger btn-sm">
                            <div class="d-flex justify-content-center">
                                <i class="fas fa-trash-alt"></i>
                              </div>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
              </tbody>
            </table>
            <div
              class="d-flex justify-content-center align-items-center"
            >
              <nav aria-label="Page navigation example">
                <ul class="pagination">
                  <li class="page-item <%= page === 1 ? 'disabled' : '' %> ">
                    <a class="page-link" href="/users?page=<%= page - 1 %><%= searchQuery ? `&search=${searchQuery}` : '' %>">Previous</a>
                  </li>
                  <% 
                    let currentPage = 1;
                    const maxPagesToShow = 10;
                    const totalPage = Math.ceil(totalUsers / 10);
                    let currentMaxPages = maxPagesToShow;
                    let endPage = Math.min(currentPage + maxPagesToShow - 1, totalPage)
                    if (page > endPage) {
                      let pageStrr = 0;
                      if (page % maxPagesToShow === 0) {
                        pageStr = (page-1).toString();
                      } else {
                        pageStr = page.toString();
                      }
                      const firstDigitOfPage = parseInt(pageStr.substring(0, 1), 10);
                      currentMaxPages = currentMaxPages * firstDigitOfPage
                      currentPage += currentMaxPages
                      endPage = Math.min(currentPage + maxPagesToShow - 1, totalPage)
                    }
                  %>     
                  <% if (endPage > maxPagesToShow) {%>
                    <li class="page-item">
                      <a class="page-link" href="/users?page=<%= currentPage - 1 %><%= searchQuery ? `&search=${searchQuery}` : '' %>">...</a>
                    </li>
                  <% } %>  
                  <% for (let i = currentPage; i <= endPage; i++ ) { %>
                    <li class="page-item  <%= i === page ? 'active' : '' %>">
                      <a class="page-link" href="/users?page=<%= i %><%= searchQuery ? `&search=${searchQuery}` : '' %>"><%= i %></a>
                    </li>
                  <% } %>
                  <% if (endPage < totalPage) {%>
                    <li class="page-item">
                      <a class="page-link" href="/users?page=<%= endPage + 1 %>">...</a>
                    </li>
                  <% } %>
                  <li class="page-item <%= page === Math.ceil(totalUsers / 10) ? 'disabled' : '' %>">
                    <a class="page-link" href="/users?page=<%= page + 1 %><%= searchQuery ? `&search=${searchQuery}` : '' %>">Next</a>
                  </li>
                </ul>
              </nav>
            </div>
          </div>  
      </div>
    </div>
  </div>

<%- include('../partial/user-footer', {userAlert}) %>