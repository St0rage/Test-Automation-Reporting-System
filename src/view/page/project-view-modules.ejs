<%- include('../partial/admin-sidebar') %>

<div class="page-header">
    <h3 class="fw-bold mb-3"><%= project.name %></h3>
    <ul class="breadcrumbs mb-3">
      <li class="nav-item">
        <a href="/projects">Projects</a>
      </li>
      <li class="separator">
        <i class="icon-arrow-right"></i>
      </li>
      <li class="nav-item">
        <a href="/projects/<%= project.team.id %>/<%= project.name.toLowerCase() %>/modules">Modules</a>
      </li>
    </ul>
</div>

<div class="row">
  <div class="col-md-12">
      <div class="card">
        <div class="card-body">
          <ul class="nav nav-tabs nav-line nav-color-secondary" id="line-tab" role="tablist">
            <li class="nav-item">
              <a class="nav-link" id="line-dashboard-tab" href="/projects/<%= project.team.id %>/<%= project.name.toLowerCase() %>/dashboard" role="tab">Dashboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" id="line-home-tab" href="/projects/<%= project.team.id %>/<%= project.name.toLowerCase() %>/modules" role="tab">Modules</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="line-profile-tab" href="#line-profile" role="tab" aria-controls="pills-profile" aria-selected="false">Activities</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="line-contact-tab" href="/projects/<%= project.team.id %>/<%= project.name.toLowerCase() %>/additional" role="tab">Additional</a>
            </li>
          </ul>
          <div class="tab-content mt-3 mb-3" id="line-tabContent">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="card-title">Module List</div>
                  <div class="d-flex align-items-center">
                    <form id="filter-form" action="/projects" method="get">
                      <input type="hidden" name="page" value="1">
                      <div class="d-flex align-items-center">
                        <div class="d-flex align-items-center">
                          <div class="px-2 text-center">
                            <span>Search</span>
                          </div>
                          <div>
                            <input
                              type="text"
                              class="form-control form-control-sm"
                              id="date-filter"
                              placeholder="module name"
                              name="search"
                              value=""
                            />
                          </div>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary ms-3">Search</button>
                      </div>
                    </form>
                    <div class="mx-3 border border-start border-dark-subtle border-1" style="height: 30px;"></div>
                    <a href="/projects/<%= project.team.id %>/<%= project.name.toLowerCase() %>/modules/add-module" class="btn btn-primary btn-sm">Add New Module</a>
                  </div>
                </div>
            </div>
            <div class="card-body">
              <table class="table table-bordered">
                <thead>
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Module</th>
                    <th scope="col">Total Scenario</th>
                    <th scope="col">Total Test Case</th>
                    <th scope="col">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% modules.forEach((module, index) => { %>
                    <tr>
                      <td>#</td>
                      <td><%= module.name %></td>
                      <td><%= module.totalScenarios %></td>
                      <td><%= module.totalTestCases %></td>
                      <td class="d-flex justify-content-center">
                        <a href="#" class="btn btn-warning btn-sm">
                          <div class="d-flex justify-content-center">
                            <i class="fas fa-eye"></i>
                          </div>
                        </a>
                        <a href="#" class="btn btn-primary btn-sm">
                          <div class="d-flex justify-content-center">
                            <i class="fas fa-pen"></i>
                          </div>
                        </a>
                        <a href="#" class="btn btn-danger btn-sm">
                          <div class="d-flex justify-content-center">
                            <i class="fas fa-trash-alt"></i>
                          </div>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
  </div>
</div>

<%- include('../partial/project-view-footer') %>