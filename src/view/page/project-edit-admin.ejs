<%- include('../partial/admin-sidebar') %>

<div class="page-header">
    <h3 class="fw-bold mb-3">Edit Project</h3>
    <ul class="breadcrumbs mb-3">
      <li class="nav-item">
        <a href="/projects">Projects</a>
      </li>
      <li class="separator">
        <i class="icon-arrow-right"></i>
      </li>
      <li class="nav-item">
        <a href="/projects/edit-project/<%= originalTeamId %>/<%= originalProjectName.toLowerCase() %>">Edit Project</a>
      </li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <div
            class="d-flex justify-content-between align-items-center"
          >
            <div class="card-title">Edit Form</div>
          </div>
        </div>
          <div class="card-body">
            <form id="edit-project-form" action="/projects/edit-project/<%= originalTeamId %>/<%= originalProjectName.toLowerCase() %>?_method=PATCH" method="post" class="need-validation d-flex justify-content-center" class="need-validation" novalidate>
              <input type="hidden" name="id" value="<%= currentProjectId %>">
              <div class="col-lg-7">
                <div class="form-group">
                  <label for="project-name-field">Project Name</label>
                  <input
                    type="text"
                    class="form-control <%= errorData.name !== undefined ? 'is-invalid' : ''%>"
                    id="name-field"
                    name="name"
                    placeholder="Enter Name"
                    value="<%= currentProjectName %>"
                    required
                  />
                  <div class="invalid-feedback" id="name-feedback">
                    <%= errorData.name !== undefined ? errorData.name[0] : ''%>
                  </div>
                </div>
                <div class="form-group">
                  <label for="exampleFormControlSelect1"
                    >Tool</label
                  >
                  <select
                    class="form-select <%= errorData.toolId !== undefined ? 'is-invalid' : ''%>"
                    id="tool"
                    name="toolId"
                  >
                    <option value="0" <%= currentToolId == "0" ? 'selected' : '' %>>-- Select a Tool --</option>
                    <% tools.forEach((tool) => { %>
                      <option value="<%= tool.id %>" <%= currentToolId == tool.id ? 'selected' : '' %>><%= tool.name %></option>
                    <% }) %>
                  </select>
                   <div class="invalid-feedback" id="name-feedback">
                    <%= errorData.toolId !== undefined ? errorData.toolId[0] : ''%>
                  </div>
                </div>
                <div class="form-group">
                  <label for="exampleFormControlSelect1"
                    >Assigned Team</label
                  >
                  <select
                    class="form-select <%= errorData.teamId !== undefined ? 'is-invalid' : ''%>"
                    id="team"
                    name="teamId"
                  >
                    <option value="0" <%= currentTeamId == "0" ? 'selected' : '' %>>-- Select a Team --</option>
                    <% teams.forEach((team) => { %>
                      <option value="<%= team.id %>" <%= currentTeamId == team.id ? 'selected' : '' %>><%= team.name %></option>
                    <% }) %>
                  </select>
                   <div class="invalid-feedback" id="name-feedback">
                    <%= errorData.teamId !== undefined ? errorData.teamId[0] : ''%>
                  </div>
                </div>
                
                <div class="form-group">                
                  <button type="submit" class="btn btn-success btn-sm">Submit</button>
                </div>
              </div>
            </form>
          </div>  
      </div>
    </div>
</div>

<% projectAlert = [] %>
<% projects = [] %>

<%- include('../partial/project-footer') %>